{
  "name": "newsapi",
  "version": "2.4.1",
  "description": "A node interface for News API from newsapi.org",
  "main": "dist/index.js",
  "scripts": {
    "build": "babel src --out-dir dist",
    "pretest": "npm run build",
    "test": "mocha test/unit.test.js",
    "test:live": "npm run build && mocha test/live.test.js",
    "prepublishOnly": "npm run build && npm test",
    "deploy": "npm publish"
  },
  "keywords": [
    "news",
    "api",
    "newsapi",
    "news api"
  ],
  "author": "Ben Zarras",
  "repository": {
    "type": "git",
    "url": "https://github.com/bzarras/newsapi"
  },
  "license": "MIT",
  "dependencies": {
    "core-js": "^3.51.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "dotenv": "^18.0.8",
    "mocha": "^12.0.3",
    "nock": "^14.0.17",
    "should": "^13.2.3"
  }
}
