{
  "name": "newsapi",
  "version": "2.5.0",
  "description": "A node interface for News API from newsapi.org",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "babel src --extensions .ts --out-dir dist && tsc",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "pretest": "npm run build && npm run typecheck",
    "test": "mocha test/unit.test.js",
    "test:live": "npm run build && mocha test/live.test.js",
    "prepublishOnly": "npm run build && npm test",
    "deploy": "npm publish"
  },
  "keywords": [
    "news",
    "api",
    "newsapi",
    "news api"
  ],
  "author": "Ben Zarras",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzarras/newsapi.git"
  },
  "license": "MIT",
  "dependencies": {
    "core-js": "^3.51.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.6.13",
    "dotenv": "^18.0.8",
    "mocha": "^12.0.3",
    "nock": "^14.0.17",
    "should": "^13.2.3",
    "typescript": "^7.0.2"
  }
}
